---
import { execSync } from 'node:child_process'
import NavLink from '@components/nav-link.astro'
import NavSocial from '@components/nav-social.astro'
import Moon from '../assets/icons/moon.svg'
import Sun from '../assets/icons/sun.svg'
import '../styles/global.css'

export interface Props {
  title?: string
  description?: string
  noindex?: boolean
  frontmatter?: {
    title?: string
    description?: string
  }
}

const DEFAULT_DESCRIPTION =
  'Dennis Kasper, AI, DevOps and simulation engineer building software in the automotive industry, from cloud infrastructure to data platforms.'

const { title, description, noindex = false, frontmatter } = Astro.props as Props
const pageTitle = title || frontmatter?.title
const pageDescription = description || frontmatter?.description || DEFAULT_DESCRIPTION
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const ogImageUrl = new URL('/og-image.png', Astro.site)

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dennis Kasper',
  url: Astro.site?.href,
  image: ogImageUrl.href,
  jobTitle: ['AI Engineer', 'DevOps Engineer', 'Simulation Engineer'],
  sameAs: ['https://github.com/denniskasper', 'https://www.linkedin.com/in/denniskasper'],
}

const year = new Date().getFullYear()

const commitHash = import.meta.env.DEV
  ? execSync('git rev-parse --short HEAD').toString().trim()
  : null
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <link
      rel="icon"
      href="/favicon.ico"
      sizes="32x32"
    />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content={pageDescription}
    />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta
      name="theme-color"
      content="#f0ece4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#13181a"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      property="og:title"
      content={pageTitle}
    />
    <meta
      property="og:description"
      content={pageDescription}
    />
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:url"
      content={canonicalUrl}
    />
    <meta
      property="og:site_name"
      content="Dennis Kasper"
    />
    <meta
      property="og:image"
      content={ogImageUrl}
    />
    <meta
      property="og:image:width"
      content="1200"
    />
    <meta
      property="og:image:height"
      content="630"
    />
    <meta
      property="og:image:alt"
      content="Dennis Kasper, AI, DevOps and simulation engineer, over a photo of him windsurfing in Hvide Sande"
    />
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personJsonLd)}
    />
    <script is:inline>
      ;(function () {
        // localStorage throws when the browser blocks site data; fall back to the OS scheme
        var saved = null
        try {
          saved = localStorage.getItem('denniskasper.com-theme')
        } catch (e) {}
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        if (saved === 'dark' || (saved === null && prefersDark)) document.documentElement.classList.add('dark')
      })()
    </script>
  </head>
  <body class="bg-light dark:bg-dark text-dark dark:text-light font-body text-base leading-relaxed antialiased">
    <div class="min-h-screen flex flex-col">
      <main class="w-full max-w-3xl mx-auto px-4 sm:px-6 md:px-8 flex-1">
        <header
          class="flex items-center justify-between pt-8 pb-12 sm:pt-10 sm:pb-16 md:pt-14 md:pb-20"
        >
          <nav
            aria-label="Main"
            class="flex items-center gap-x-4 sm:gap-x-6 md:gap-x-8"
          >
            <NavLink
              title="Home"
              url="/"
            />
            <NavLink
              title="Resume"
              url="/resume/"
            />
          </nav>
          <div class="flex items-center gap-x-3">
            <nav
              aria-label="Profiles"
              class="flex items-center gap-x-3"
            >
              <NavSocial
                icon="github"
                link="https://github.com/denniskasper"
              />
              <NavSocial
                icon="linkedin"
                link="https://www.linkedin.com/in/denniskasper"
              />
            </nav>
            <button
              data-theme-toggle
              class="ml-3 p-2.5 rounded-full hover:bg-dark/5 dark:hover:bg-light/5 transition-colors duration-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-light dark:focus-visible:ring-offset-dark"
              aria-label="Dark theme"
              aria-pressed="false"
            >
              <Moon
                aria-hidden="true"
                class="h-5 w-5 dark:hidden"
              />
              <Sun
                aria-hidden="true"
                class="h-5 w-5 hidden dark:block"
              />
            </button>
          </div>
        </header>
        <article>
          <slot />
        </article>
      </main>

      <footer class="w-full max-w-3xl mx-auto px-4 sm:px-6 md:px-8 py-12 mt-20">
        <div class="flex items-center justify-between text-sm text-muted-light dark:text-muted-dark">
          <span>&copy; {year} Dennis Kasper</span>
          <span class="flex items-baseline gap-1.5">
            {commitHash && <span class="font-mono text-xs leading-none opacity-40 mr-1.5">{commitHash}</span>}
            <a
              href="https://github.com/denniskasper/denniskasper.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Source on GitHub (opens in new tab)"
              class="hover:text-dark dark:hover:text-light transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-light dark:focus-visible:ring-offset-dark rounded-sm"
            >
              Source on GitHub
            </a>
          </span>
        </div>
      </footer>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const localStorageTheme = 'denniskasper.com-theme'

        const toggle = document.querySelector('[data-theme-toggle]') as HTMLButtonElement

        // localStorage throws when the browser blocks site data. The toggle must
        // still work then; the choice just isn't remembered.
        const storage = (action: (s: Storage) => void) => {
          try {
            action(localStorage)
          } catch {}
        }

        // Left over from the removed consent banner
        storage((s) => s.removeItem('denniskasper.com-storageAccepted'))

        const syncTheme = (isDark: boolean) => {
          toggle.setAttribute('aria-pressed', String(isDark))

          // The theme-color tags follow the OS scheme, which an explicit toggle can
          // contradict. Point them all at the page background actually shown.
          const background = getComputedStyle(document.body).backgroundColor
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((meta) => meta.setAttribute('content', background))
        }

        // Sync to the theme already applied by the head script
        syncTheme(document.documentElement.classList.contains('dark'))

        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark')

          syncTheme(isDark)
          storage((s) => s.setItem(localStorageTheme, isDark ? 'dark' : 'light'))

          // Replay the draw-in animation of the icon that just appeared
          toggle.querySelectorAll('svg').forEach((svg) => svg.setCurrentTime(0))
        })

        console.log(
          '%cDK%c\n\nHey, fellow developer. Curious how this is built?\nSource: https://github.com/denniskasper/denniskasper.com\nSay hi: https://www.linkedin.com/in/denniskasper',
          'font: 700 48px "Playfair Display", Georgia, serif; color: #c8a45e;',
          'font: 14px system-ui, sans-serif; color: inherit;',
        )
      })
    </script>
  </body>
</html>

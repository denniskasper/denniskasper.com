---
import Layout from '@layouts/layout.astro'
---

<Layout
  title="404 | Dennis Kasper"
  noindex
>
  <div class="flex flex-col items-center justify-center pt-24 md:pt-32 text-center">
    <h1 class="font-display text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-bold text-accent/20 mb-4">404</h1>
    <p class="text-lg text-muted-light dark:text-muted-dark mb-8">
      This page drifted away.
    </p>
    <a
      href="/"
      class="text-lg font-medium text-accent-ink dark:text-accent hover:text-dark dark:hover:text-light transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-light dark:focus-visible:ring-offset-dark rounded-sm"
    >
      Back to shore
    </a>
  </div>
</Layout>

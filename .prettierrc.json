{
  "semi": false,
  "singleQuote": true,
  "singleAttributePerLine": true,
  "printWidth": 120,
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": "*.jsonc",
      "options": { "trailingComma": "none" }
    }
  ]
}

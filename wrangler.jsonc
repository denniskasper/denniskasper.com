{
  // Static-only Worker: no `main` entry point, Cloudflare serves ./dist directly.
  // `astro build` writes dist/, including the custom 404 page.
  "name": "denniskasper-com",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}

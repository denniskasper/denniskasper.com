{
  // Static-only Worker: no `main` entry point, Cloudflare serves ./dist directly.
  // `astro build` writes dist/, including the custom 404 page.
  "name": "denniskasper-com",
  "compatibility_date": "2026-09-22",
  // Serve only from the custom domain. Without this the site is also public at
  // denniskasper-com.dennis-m-kasper.workers.dev, which search engines index as
  // duplicate content.
  "workers_dev": false,
  // Preview URLs are served on the workers.dev subdomain, so they cannot work with
  // workers_dev disabled. Stated explicitly so preview builds do not fail trying.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
